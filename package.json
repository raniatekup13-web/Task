{
  "name": "devtask-enterprise",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace apps/api run start:dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm run db:generate && npm run build --workspaces --if-present",
    "db:generate": "npm --workspace packages/db run generate",
    "db:push": "npm --workspace packages/db run push"
  },
  "devDependencies": {"concurrently":"^9.1.2","typescript":"^5.7.3"}
}
